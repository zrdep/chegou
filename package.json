{
  "name": "chegou",
  "version": "1.6.1",
  "description": "Move files between your phone and your PC over the local network. One command, one QR code, done.",
  "type": "module",
  "bin": {
    "chegou": "bin/chegou.js"
  },
  "files": [
    "bin",
    "src",
    "public"
  ],
  "scripts": {
    "start": "node bin/chegou.js",
    "dev": "node --watch bin/chegou.js"
  },
  "keywords": [
    "file-transfer",
    "lan",
    "qrcode",
    "upload",
    "cli",
    "mobile",
    "local-network",
    "share",
    "qr",
    "transfer",
    "wifi",
    "phone",
    "android",
    "iphone",
    "airdrop"
  ],
  "author": "Pedro Randolfo",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/zrdep/chegou.git"
  },
  "homepage": "https://github.com/zrdep/chegou#readme",
  "bugs": {
    "url": "https://github.com/zrdep/chegou/issues"
  },
  "license": "MIT",
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@fastify/multipart": "^10.1.2",
    "@fastify/static": "^10.1.4",
    "fastify": "^5.12.5",
    "picocolors": "^1.1.1",
    "qrcode-terminal": "^0.12.0",
    "untun": "^0.2.2"
  }
}
